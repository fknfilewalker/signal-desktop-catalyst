+    /// Copies a dropped file into our container: the provider's file is only available during
+    /// its callback.
+    private static func copyDroppedFile(from itemProvider: NSItemProvider) async -> URL? {
+        let typeIdentifiers = itemProvider.registeredTypeIdentifiers
+        guard
+            let typeIdentifier = typeIdentifiers.first(where: { UTType($0)?.conforms(to: .data) == true })
+                ?? typeIdentifiers.first
+        else {
+            return nil
+        }
+        return await withCheckedContinuation { continuation in
+            _ = itemProvider.loadFileRepresentation(forTypeIdentifier: typeIdentifier) { url, error in
+                guard let url else {
+                    Logger.warn("Couldn't load dropped file: \(error as Optional)")
+                    continuation.resume(returning: nil)
+                    return
+                }
+                let copyUrl = OWSFileSystem.temporaryFileUrl(
+                    fileName: url.lastPathComponent,
+                    isAvailableWhileDeviceLocked: false,
+                )
+                do {
+                    try FileManager.default.copyItem(at: url, to: copyUrl)
+                    continuation.resume(returning: copyUrl)
+                } catch {
+                    Logger.warn("Couldn't copy dropped file: \(error)")
+                    continuation.resume(returning: nil)
+                }
+            }
+        }
+    }
+}
