+    private static let functions: Functions = {
+        let handle = dlopen("/System/Library/Frameworks/Security.framework/Security", RTLD_NOW)
+        func load<T>(_ name: String, as type: T.Type) -> T {
+            guard let symbol = dlsym(handle, name) else {
+                owsFail("Missing \(name)")
+            }
+            return unsafeBitCast(symbol, to: type)
+        }
+        return Functions(
+            add: load("SecKeychainAddGenericPassword", as: AddFn.self),
+            find: load("SecKeychainFindGenericPassword", as: FindFn.self),
+            modify: load("SecKeychainItemModifyAttributesAndData", as: ModifyFn.self),
+            delete: load("SecKeychainItemDelete", as: DeleteFn.self),
+            freeContent: load("SecKeychainItemFreeContent", as: FreeContentFn.self),
+        )
+    }()
+
+    private static func find(service: String, key: String) throws -> (item: CFTypeRef, data: Data) {
+        let service = Array(service.utf8), key = Array(key.utf8)
+        var length: UInt32 = 0
+        var bytes: UnsafeMutableRawPointer?
+        var item: Unmanaged<CFTypeRef>?
+        let status = functions.find(
+            nil, UInt32(service.count), service, UInt32(key.count), key,
+            &length, &bytes, &item,
+        )
+        guard status == errSecSuccess, let item else {
+            throw KeychainError(status)
+        }
+        var data = Data()
+        if let bytes {
+            data = Data(bytes: bytes, count: Int(length))
+            _ = functions.freeContent(nil, bytes)
+        }
+        return (item.takeRetainedValue(), data)
+    }
+
+    static func dataValue(service: String, key: String) throws -> Data {
+        return try find(service: service, key: key).data
+    }
+
+    static func setDataValue(_ dataValue: Data, service: String, key: String) throws {
+        let status: OSStatus
+        do {
+            let item = try find(service: service, key: key).item
+            status = dataValue.withUnsafeBytes { functions.modify(item, nil, UInt32($0.count), $0.baseAddress) }
+        } catch KeychainError.notFound {
+            let service = Array(service.utf8), key = Array(key.utf8)
+            status = dataValue.withUnsafeBytes {
+                functions.add(nil, UInt32(service.count), service, UInt32(key.count), key, UInt32($0.count), $0.baseAddress, nil)
+            }
+        }
+        guard status == errSecSuccess else {
+            throw KeychainError(status)
+        }
+    }
+
+    static func removeValue(service: String, key: String) throws {
+        let item: CFTypeRef
+        do {
+            item = try find(service: service, key: key).item
+        } catch KeychainError.notFound {
+            return
+        }
+        let status = functions.delete(item)
+        guard status == errSecSuccess || status == errSecItemNotFound else {
+            throw KeychainError(status)
+        }
+    }
+}
+
+#endif
