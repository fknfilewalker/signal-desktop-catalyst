// Build settings for the Mac Catalyst build of Signal-iOS (script/build-catalyst.sh).
// Passed with -xcconfig, so they apply on top of every target's own settings, including Pods,
// without modifying the Signal-iOS submodule. SIGNAL_MAC_DEPS points at build/deps.

SUPPORTS_MACCATALYST = YES
ARCHS = arm64

// RingRTC built for aarch64-apple-ios-macabi by script/build-catalyst-deps.sh. (libsignal and
// libmobilecoin are Swift package XCFrameworks; build-catalyst.sh adds their Catalyst slices.)
LIBRINGRTC_IF_NEEDED = $(SIGNAL_MAC_DEPS)/ringrtc/out/release/libringrtc/aarch64-apple-ios-macabi/libringrtc.a

// The Pods only copy WebRTC's iOS slices; use the Catalyst framework instead. CatalystStubs holds
// link-time stand-ins for iOS-only frameworks the project links explicitly.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SIGNAL_MAC_DEPS)/webrtc-catalyst $(SIGNAL_MAC_CONFIG)/CatalystStubs
OTHER_LDFLAGS = $(inherited) -weak_framework DeviceDiscoveryUI

// Report every Swift error in a module per build, not just the first failing batch.
OTHER_SWIFT_FLAGS = $(inherited) -continue-building-after-errors
