// Build settings for the Mac Catalyst build of Signal-iOS (script/build-catalyst.sh).
// Passed with -xcconfig, so they apply on top of every target's own settings, including Swift
// packages, without modifying the Signal-iOS submodule. SIGNAL_MAC_CONFIG points at Config/.
// (The native libraries are Swift package XCFrameworks; build-catalyst.sh adds their Catalyst
// slices.)

SUPPORTS_MACCATALYST = YES
ARCHS = arm64

// CatalystStubs holds link-time stand-ins for iOS-only frameworks the project links explicitly.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SIGNAL_MAC_CONFIG)/CatalystStubs
OTHER_LDFLAGS = $(inherited) -weak_framework DeviceDiscoveryUI

// Report every Swift error in a module per build, not just the first failing batch.
OTHER_SWIFT_FLAGS = $(inherited) -continue-building-after-errors
